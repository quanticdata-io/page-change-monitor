{
  "name": "page-change-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Watch public web pages for text, price and stock changes on a schedule, with git-diffable snapshots, webhook and Slack alerts, and a GitHub Action.",
  "keywords": ["change-detection", "website-monitoring", "price-monitoring", "web-scraping", "github-action", "cli"],
  "homepage": "https://github.com/quanticdata-io/page-change-monitor#readme",
  "bugs": {
    "url": "https://github.com/quanticdata-io/page-change-monitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanticdata-io/page-change-monitor.git"
  },
  "license": "MIT",
  "author": "QuanticData <hello@quanticdata.io>",
  "type": "module",
  "bin": {
    "page-change-monitor": "dist/cli.js"
  },
  "files": ["dist", "action.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.1"
  }
}
